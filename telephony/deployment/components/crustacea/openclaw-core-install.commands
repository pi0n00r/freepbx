# Selected operator phase; not a standalone runner.

# Keep the caller's private checkpoint mask; only the root npm child uses 022.
sudo /bin/bash -c '
    umask 022
    exec /usr/bin/npm install -g --prefix /usr --prefer-offline --allow-scripts=openclaw "$1"
' openclaw-core-install "$CORE_TGZ"
